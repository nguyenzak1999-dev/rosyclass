// ------------------------------------------------------

model TeacherPayroll {
  id        String  @id @default(uuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  month Int // Tháng tính lương (1-12)
  year  Int // Năm tính lương

  totalHours Float // Tổng số giờ dạy đã hoàn thành
  hourlyRate Float // Mức lương/giờ tại thời điểm chốt
  baseAmount Float // totalHours * hourlyRate

  bonusAmount Float   @default(0) // Thưởng
  bonusReason String?

  deductAmount Float   @default(0) // Khấu trừ
  deductReason String?

  totalAmount Float // Thực lãnh = baseAmount + bonusAmount - deductAmount

  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  notes       String?
  historyLogs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, month, year])
  @@index([month, year])
  @@index([teacherId, status])
}

// ------------------------------------------------------

// Kèm bù 30 phút (mặc định hôm sau) cho mỗi buổi học sinh nghỉ.
// Đã kèm bù thì không trừ học phí; không bù được (MISSED) thì trừ vào phiếu thu kế tiếp (creditedPaymentId).
model MakeUpLesson {
  id              String       @id @default(uuid())
  scheduledDate   DateTime
  startTime       String? // "HH:mm"
  durationMinutes Int          @default(30)
  status          MakeUpStatus @default(PENDING)
  note            String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Buổi học bị nghỉ
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  creditedPaymentId String?
  creditedPayment   Payment? @relation(fields: [creditedPaymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([scheduledDate])
}

enum MakeUpStatus {
  PENDING
  DONE
  MISSED
}
