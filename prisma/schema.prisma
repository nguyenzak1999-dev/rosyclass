generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// SYSTEM & AUTH
// ------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Relations to specific profiles
  studentProfile Student?
  parentProfile  Parent?
  teacherProfile Teacher?

  // Audit trails
  createdLeads             Lead[]         @relation("LeadAssignedTo")
  leadNotes                LeadNote[]
  paymentsCreated          Payment[]      @relation("PaymentCreatedBy")
  notifications            Notification[]
  activityLogs             ActivityLog[]
  teachingAssistantClasses Class[]        @relation("ClassTeachingAssistant")
  scoresCreated            Score[]        @relation("ScoreCreatedBy")
  classNotesAuthored       ClassNote[]    @relation("ClassNoteAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  name        String // e.g. "Super Admin", "Teacher"
  code        String  @unique // SUPER_ADMIN, ADMIN, CONSULTANT, ACCOUNTANT, TEACHER, STUDENT, PARENT
  description String?
  isSystem    Boolean @default(false) // System roles cannot be deleted

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. "users.create", "classes.read"
  module      String // e.g. "users", "classes", "leads"
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  rooms   Room[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id       String  @id @default(uuid())
  name     String
  capacity Int
  isActive Boolean @default(true)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  classes        Class[]
  classSchedules ClassSchedule[]
  classSessions  ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// CRM & LEADS
// ------------------------------------------------------

model Lead {
  id           String     @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  age          Int?
  parentName   String?
  parentPhone  String?
  learningGoal String?
  currentLevel String?
  source       String?
  status       LeadStatus @default(NEW)
  followUpDate DateTime?
  notes        String?    @db.Text

  interestedCourseId String?
  interestedCourse   Course? @relation(fields: [interestedCourseId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  leadNotes      LeadNote[]
  placementTests PlacementTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadNote {
  id      String @id @default(uuid())
  content String @db.Text

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// ACADEMIC & PEOPLE
// ------------------------------------------------------

model Parent {
  id           String  @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  relationship String?
  address      String?
  notes        String? @db.Text

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String        @id @default(uuid())
  code         String?       @unique
  fullName     String
  phone        String?
  email        String?
  dateOfBirth  DateTime?
  gender       String?
  address      String?
  currentLevel String?
  learningGoal String?
  status       StudentStatus @default(ACTIVE)
  source       String?
  joinedAt     DateTime      @default(now())
  notes        String?       @db.Text

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id])

  classStudents  ClassStudent[]
  attendances    Attendance[]
  payments       Payment[]
  placementTests PlacementTest[]
  scores         Score[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id             String        @id @default(uuid())
  fullName       String
  phone          String
  email          String?
  avatar         String?
  bio             String?       @db.Text
  specialties     String? // JSON or comma separated
  certificates    String? // JSON or comma separated
  bankName        String? // e.g. "MB"
  bankAccountNo   String? // e.g. "0988888888"
  bankAccountName String? // e.g. "NGUYEN VAN A"
  hourlyRate      Float         @default(0)
  status         TeacherStatus @default(ACTIVE)
  showOnHomepage Boolean       @default(false)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  classes   Class[]
  schedules ClassSchedule[]
  sessions  ClassSession[]
  payrolls  TeacherPayroll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// COURSES & CLASSES
// ------------------------------------------------------

model Course {
  id                     String       @id @default(uuid())
  name                   String
  slug                   String       @unique
  level                  CourseLevel
  description            String?      @db.Text
  targetAudience         String?
  learningOutcomes       String?      @db.Text
  totalSessions          Int          @default(0)
  sessionDurationMinutes Int          @default(90)
  tuitionFee             Float        @default(0)
  salePrice              Float?
  thumbnail              String?
  isPublished            Boolean      @default(false)
  status                 EntityStatus @default(ACTIVE)

  classes        Class[]
  leads          Lead[]
  payments       Payment[]
  placementTests PlacementTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id              String      @id @default(uuid())
  name            String
  maxStudents     Int         @default(15)
  startDate       DateTime?
  expectedEndDate DateTime?
  status          ClassStatus @default(UPCOMING)
  notes           String?     @db.Text

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  teachingAssistantId String?
  teachingAssistant   User?   @relation("ClassTeachingAssistant", fields: [teachingAssistantId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  tuitionFee Float? // Override course tuition fee

  students       ClassStudent[]
  schedules      ClassSchedule[]
  sessions       ClassSession[]
  payments       Payment[]
  scores         Score[]
  classNotes     ClassNote[]
  placementTests PlacementTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassStudent {
  classId   String
  studentId String
  status    StudentClassStatus @default(ACTIVE)
  joinedAt  DateTime           @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
}

model ClassSchedule {
  id        String @id @default(uuid())
  dayOfWeek Int // 0 = Sunday, 1 = Monday, etc.
  startTime String // format "HH:mm"
  endTime   String // format "HH:mm"

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  sessions ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSession {
  id          String        @id @default(uuid())
  sessionDate DateTime
  startTime   String // format "HH:mm"
  endTime     String // format "HH:mm"
  status      SessionStatus @default(SCHEDULED)
  topic       String?
  notes       String?       @db.Text

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  scheduleId String?
  schedule   ClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  attendances Attendance[]
  scores      Score[]
  classNotes  ClassNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sessionDate, startTime])
  @@index([sessionDate])
  @@index([classId, sessionDate])
}

model Attendance {
  id     String           @id @default(uuid())
  status AttendanceStatus
  note   String?          @db.Text

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
}

// ------------------------------------------------------
// PAYMENTS & TESTS
// ------------------------------------------------------

model Payment {
  id              String        @id @default(uuid())
  receiptCode     String?       @unique
  totalAmount     Float
  paidAmount      Float         @default(0)
  remainingAmount Float         @default(0)
  paymentMethod   PaymentMethod @default(CASH)
  paymentDate     DateTime?
  dueDate         DateTime?
  status          PaymentStatus @default(UNPAID)
  qrPayload       String?       @db.Text
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  note            String?       @db.Text

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  createdById String
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  lineItems PaymentLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentLineItem {
  id          String          @id @default(uuid())
  description String
  category    PaymentCategory @default(TUITION)
  quantity    Int             @default(1)
  unitAmount  Float
  totalAmount Float

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId])
}

model PlacementTest {
  id             String   @id @default(uuid())
  testDate       DateTime
  listeningScore Float?
  readingScore   Float?
  writingScore   Float?
  speakingScore  Float?
  totalScore     Float?
  levelResult    String?
  teacherComment String?  @db.Text

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  suggestedCourseId String?
  suggestedCourse   Course? @relation(fields: [suggestedCourseId], references: [id])

  suggestedClassId String?
  suggestedClass   Class?  @relation(fields: [suggestedClassId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlacementQuestion {
  id           String       @id @default(uuid())
  type         String
  question     String       @db.Text
  options      String       @db.Text // JSON array of answer choices
  correctIndex Int
  order        Int          @default(0)
  level        CourseLevel?
  isPublished  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// SCORES & CLASS NOTES
// ------------------------------------------------------

model Score {
  id       String    @id @default(uuid())
  type     ScoreType
  value    Float
  maxValue Float     @default(10)
  note     String?   @db.Text
  date     DateTime  @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ScoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, date])
  @@index([studentId, classId])
}

model ClassNote {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ClassNoteAuthor", fields: [authorId], references: [id])

  @@index([classId, createdAt])
}

// ------------------------------------------------------
// CMS & LOGS
// ------------------------------------------------------

model Page {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  content        String       @db.Text
  seoTitle       String?
  seoDescription String?
  status         EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id       String       @id @default(uuid())
  question String       @db.Text
  answer   String       @db.Text
  category String?
  position Int          @default(0)
  status   EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  excerpt        String?      @db.Text
  content        String       @db.Text
  thumbnail      String?
  status         EntityStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String  @id @default(uuid())
  title      String?
  subtitle   String?
  image      String
  buttonText String?
  buttonUrl  String?
  position   Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFile {
  id       String  @id @default(uuid())
  url      String // Cloudinary secure_url
  publicId String  @unique // Cloudinary public_id (for deletion)
  name     String // Original file name
  alt      String? // Alt text
  folder   String  @default("general") // Cloudinary folder / category
  format   String? // jpg, png, webp...
  width    Int?
  height   Int?
  bytes    Int? // file size in bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String  @id @default(uuid())
  authorName  String
  authorTitle String?
  content     String  @db.Text
  avatar      String?
  rating      Int     @default(5)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id      String  @id @default(uuid())
  title   String
  message String  @db.Text
  isRead  Boolean @default(false)
  link    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String  @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  details    String? @db.Text // Can be JSON string

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  NO_ANSWER
  CONSULTED
  PLACEMENT_TEST_BOOKED
  TESTED
  WAITING_FOR_PAYMENT
  ENROLLED
  LOST
}

enum StudentStatus {
  ACTIVE
  WAITING_CLASS
  RESERVED
  PAUSED
  COMPLETED
  DROPPED
}

enum StudentClassStatus {
  ACTIVE
  DROPPED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum CourseLevel {
  KIDS
  STARTER
  A1
  A2
  B1
  B2
  IELTS_FOUNDATION
  IELTS_5_5
  IELTS_6_5
  TOEIC
  COMMUNICATION
  ONE_ON_ONE
}

enum ClassStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MAKE_UP
}

enum AttendanceStatus {
  PRESENT
  ABSENT_WITH_PERMISSION
  ABSENT_WITHOUT_PERMISSION
  LATE
  MAKE_UP
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentCategory {
  TUITION
  MATERIAL
  TEST
  MAKE_UP
  DISCOUNT
  OTHER
}

enum ScoreType {
  QUIZ
  MIDTERM
  FINAL
  SPEAKING
  WRITING
  LISTENING
  READING
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PAID
}

// ------------------------------------------------------

model TeacherPayroll {
  id           String        @id @default(uuid())
  teacherId    String
  teacher      Teacher       @relation(fields: [teacherId], references: [id])

  month        Int           // Tháng tính lương (1-12)
  year         Int           // Năm tính lương

  totalHours   Float         // Tổng số giờ dạy đã hoàn thành
  hourlyRate   Float         // Mức lương/giờ tại thời điểm chốt
  baseAmount   Float         // totalHours * hourlyRate

  bonusAmount  Float         @default(0) // Thưởng
  bonusReason  String?       @db.Text

  deductAmount Float         @default(0) // Khấu trừ
  deductReason String?       @db.Text

  totalAmount  Float         // Thực lãnh = baseAmount + bonusAmount - deductAmount

  status       PayrollStatus @default(DRAFT)
  paidAt       DateTime?
  notes        String?       @db.Text
  historyLogs  Json?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([teacherId, month, year])
  @@index([month, year])
  @@index([teacherId, status])
}

// ------------------------------------------------------
