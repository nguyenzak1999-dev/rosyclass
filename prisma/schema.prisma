// Client cho Worker: runtime "cloudflare" import query compiler (WASM) như một module,
// vì Workers production không cho biên dịch WASM lúc chạy
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "cloudflare"
  moduleFormat = "esm"
}

// Client cho script chạy bằng Node (seed, backfill, set-password)
generator scripts {
  provider     = "prisma-client"
  output       = "../prisma/generated/node"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// ------------------------------------------------------
// SYSTEM & AUTH
// ------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Relations to specific profiles
  studentProfile Student?
  parentProfile  Parent?
  teacherProfile Teacher?

  // Audit trails
  createdLeads             Lead[]               @relation("LeadAssignedTo")
  leadNotes                LeadNote[]
  paymentsCreated          Payment[]            @relation("PaymentCreatedBy")
  notifications            Notification[]
  activityLogs             ActivityLog[]
  teachingAssistantClasses Class[]              @relation("ClassTeachingAssistant")
  scoresCreated            Score[]              @relation("ScoreCreatedBy")
  classNotesAuthored       ClassNote[]          @relation("ClassNoteAuthor")
  sessionFeedbackCreated   SessionFeedback[]    @relation("SessionFeedbackCreatedBy")
  homeworkCreated          Homework[]           @relation("HomeworkCreatedBy")
  homeworkReviewed         HomeworkSubmission[] @relation("HomeworkReviewedBy")
  skillAssessmentsCreated  SkillAssessment[]    @relation("SkillAssessmentAssessedBy")
  progressReportsCreated   ProgressReport[]     @relation("ProgressReportCreatedBy")
  parentTokensCreated      ParentAccessToken[]  @relation("ParentAccessTokenCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  name        String // e.g. "Super Admin", "Teacher"
  code        String  @unique // SUPER_ADMIN, ADMIN, CONSULTANT, ACCOUNTANT, TEACHER, STUDENT, PARENT
  description String?
  isSystem    Boolean @default(false) // System roles cannot be deleted

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. "users.create", "classes.read"
  module      String // e.g. "users", "classes", "leads"
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  rooms   Room[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id       String  @id @default(uuid())
  name     String
  capacity Int
  isActive Boolean @default(true)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  classes        Class[]
  classSchedules ClassSchedule[]
  classSessions  ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// CRM & LEADS
// ------------------------------------------------------

model Lead {
  id           String     @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  age          Int?
  parentName   String?
  parentPhone  String?
  learningGoal String?
  currentLevel String?
  source       String?
  status       LeadStatus @default(NEW)
  followUpDate DateTime?
  notes        String?

  interestedCourseId String?
  interestedCourse   Course? @relation(fields: [interestedCourseId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  leadNotes      LeadNote[]
  placementTests PlacementTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadNote {
  id      String @id @default(uuid())
  content String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// ACADEMIC & PEOPLE
// ------------------------------------------------------

model Parent {
  id           String  @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  relationship String?
  address      String?
  notes        String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  students     Student[]
  accessTokens ParentAccessToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String        @id @default(uuid())
  code         String?       @unique
  fullName     String
  phone        String?
  email        String?
  dateOfBirth  DateTime?
  gender       String?
  address      String?
  currentLevel String?
  learningGoal String?
  status       StudentStatus @default(ACTIVE)
  source       String?
  joinedAt     DateTime      @default(now())
  notes        String?
  // Miễn/giảm học phí mặc định (%) áp vào phiếu thu tháng: con em nhân viên, anh chị em, học bổng…
  tuitionDiscountPercent Float @default(0)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id])

  classStudents  ClassStudent[]
  attendances    Attendance[]
  payments       Payment[]
  placementTests PlacementTest[]
  scores         Score[]
  feedbacks      SessionFeedback[]

  homeworkSubmissions HomeworkSubmission[]
  skillAssessments    SkillAssessment[]
  progressReports     ProgressReport[]
  makeUpLessons       MakeUpLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id              String        @id @default(uuid())
  fullName        String
  phone           String
  email           String?
  avatar          String?
  bio             String?
  specialties     String? // JSON or comma separated
  certificates    String? // JSON or comma separated
  bankName        String? // e.g. "MB"
  bankAccountNo   String? // e.g. "0988888888"
  bankAccountName String? // e.g. "NGUYEN VAN A"
  hourlyRate      Float         @default(0)
  status          TeacherStatus @default(ACTIVE)
  showOnHomepage  Boolean       @default(false)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  classes       Class[]
  schedules     ClassSchedule[]
  sessions      ClassSession[]
  payrolls      TeacherPayroll[]
  makeUpLessons MakeUpLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// COURSES & CLASSES
// ------------------------------------------------------

model Course {
  id                     String       @id @default(uuid())
  name                   String
  slug                   String       @unique
  level                  CourseLevel
  description            String?
  targetAudience         String?
  learningOutcomes       String?
  totalSessions          Int          @default(0)
  sessionDurationMinutes Int          @default(90)
  tuitionFee             Float        @default(0)
  salePrice              Float?
  // Học phí thu theo tháng: đơn giá mỗi buổi (lớp có thể ghi đè)
  sessionFee             Float?
  thumbnail              String?
  isPublished            Boolean      @default(false)
  status                 EntityStatus @default(ACTIVE)

  classes        Class[]
  leads          Lead[]
  payments       Payment[]
  placementTests PlacementTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id              String      @id @default(uuid())
  name            String
  maxStudents     Int         @default(15)
  startDate       DateTime?
  expectedEndDate DateTime?
  status          ClassStatus @default(UPCOMING)
  notes           String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  teachingAssistantId String?
  teachingAssistant   User?   @relation("ClassTeachingAssistant", fields: [teachingAssistantId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  // Chương trình học (Unit / Bài) mà lớp đang dùng
  curriculumId String?
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  tuitionFee Float? // Override course tuition fee
  sessionFee Float? // Đơn giá/buổi riêng của lớp (ghi đè khoá học)
  isOneOnOne Boolean @default(false) // Lớp học riêng 1-1 với giáo viên Việt Nam

  students       ClassStudent[]
  schedules      ClassSchedule[]
  sessions       ClassSession[]
  payments       Payment[]
  scores         Score[]
  classNotes     ClassNote[]
  placementTests PlacementTest[]

  homework         Homework[]
  skillAssessments SkillAssessment[]
  progressReports  ProgressReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([curriculumId])
}

model ClassStudent {
  classId   String
  studentId String
  status    StudentClassStatus @default(ACTIVE)
  joinedAt  DateTime           @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
}

model ClassSchedule {
  id        String @id @default(uuid())
  dayOfWeek Int // 0 = Sunday, 1 = Monday, etc.
  startTime String // format "HH:mm"
  endTime   String // format "HH:mm"

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  sessions ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSession {
  id          String        @id @default(uuid())
  sessionDate DateTime
  startTime   String // format "HH:mm"
  endTime     String // format "HH:mm"
  status      SessionStatus @default(SCHEDULED)
  topic       String?
  notes       String?

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  scheduleId String?
  schedule   ClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  // Bài học trong chương trình được dạy ở buổi này
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // Buổi học thêm với giáo viên nước ngoài (ngoài lịch): thu đơn giá buổi + phụ thu
  isForeignTeacher Boolean @default(false)
  surcharge        Float   @default(0)

  attendances   Attendance[]
  makeUpLessons MakeUpLesson[]
  scores        Score[]
  classNotes    ClassNote[]
  feedbacks     SessionFeedback[]
  homework      Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sessionDate, startTime])
  @@index([sessionDate])
  @@index([classId, sessionDate])
  @@index([lessonId])
}

model Attendance {
  id     String           @id @default(uuid())
  status AttendanceStatus
  note   String?

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
}

// ------------------------------------------------------
// CURRICULUM (chương trình học: Unit → Bài) & SESSION FEEDBACK
// ------------------------------------------------------

model Curriculum {
  id          String       @id @default(uuid())
  name        String
  gradeLabel  String // e.g. "Lớp 1"
  description String?
  sourceBook  String? // Giáo trình gốc (ghi tự do)
  status      EntityStatus @default(ACTIVE)

  units   CurriculumUnit[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CurriculumUnit {
  id               String  @id @default(uuid())
  order            Int
  title            String
  objectives       String?
  vocabulary       String  @default("[]") // JSON array of words
  sentencePatterns String  @default("[]") // JSON array of patterns
  phonics          String?
  songUrl          String?

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  lessons          Lesson[]
  skillAssessments SkillAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([curriculumId, order])
}

model Lesson {
  id         String  @id @default(uuid())
  order      Int
  title      String
  objectives String?
  activities String? // Giáo án (nhiều dòng)
  materials  String?
  mediaUrl   String?
  homework   String?

  unitId String
  unit   CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  sessions            ClassSession[]
  homeworkAssignments Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, order])
}

/// Sao thưởng & nhận xét nhanh của từng bé trong một buổi học
model SessionFeedback {
  id      String  @id @default(uuid())
  stars   Int     @default(0) // 0–5
  praises String  @default("[]") // JSON array of praise tags
  mood    String?
  comment String?

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("SessionFeedbackCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ------------------------------------------------------
// BÀI TẬP VỀ NHÀ, ĐÁNH GIÁ KỸ NĂNG, BÁO CÁO TIẾN BỘ (lớp 1)
// Các cột "kiểu enum" lưu dạng String để thêm giá trị mới không cần migration
// ------------------------------------------------------

/// Bài tập về nhà giao cho cả lớp (thường gắn với một buổi / bài học)
model Homework {
  id           String    @id @default(uuid())
  title        String
  instructions String?
  kind         String    @default("OTHER") // DRAWING | SPEAKING | LISTENING | WORKSHEET | OTHER
  dueDate      DateTime?

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("HomeworkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  submissions HomeworkSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, createdAt])
  @@index([sessionId])
}

/// Bài nộp của một bé (phụ huynh nộp ảnh/ghi âm, hoặc giáo viên ghi nhận "đã làm trên lớp")
model HomeworkSubmission {
  id             String    @id @default(uuid())
  submittedBy    String    @default("PARENT") // PARENT | TEACHER
  mediaUrl       String?
  mediaType      String? // image | audio | video
  parentNote     String?
  sticker        String?
  teacherComment String?
  status         String    @default("SUBMITTED") // SUBMITTED | REVIEWED
  reviewedAt     DateTime?

  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("HomeworkReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([homeworkId, studentId])
  @@index([status, createdAt])
  @@index([studentId])
}

/// Đánh giá kỹ năng cuối Unit: mức 1 Cần cố gắng / 2 Đạt / 3 Tốt
model SkillAssessment {
  id    String  @id @default(uuid())
  skill String // LISTENING | SPEAKING | READING | WRITING | PHONICS
  level Int // 1–3
  note  String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  unitId String
  unit   CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  assessedById String?
  assessedBy   User?   @relation("SkillAssessmentAssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, unitId, skill])
  @@index([classId, unitId])
}

/// Báo cáo tiến bộ của một bé trong một kỳ (số liệu tổng hợp lưu dạng JSON)
model ProgressReport {
  id             String    @id @default(uuid())
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  data           String    @default("{}") // JSON snapshot, xem src/lib/progress-report.ts
  teacherComment String?
  status         String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt    DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ProgressReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, periodStart])
  @@index([studentId, status])
}

// ------------------------------------------------------
// CỔNG PHỤ HUYNH
// ------------------------------------------------------

/// Link đăng nhập gửi cho phụ huynh. Chỉ lưu SHA-256 của token; thu hồi có hiệu lực ngay
model ParentAccessToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  label      String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ParentAccessTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ------------------------------------------------------
// PAYMENTS & TESTS
// ------------------------------------------------------

model Payment {
  id              String        @id @default(uuid())
  receiptCode     String?       @unique
  totalAmount     Float
  paidAmount      Float         @default(0)
  remainingAmount Float         @default(0)
  paymentMethod   PaymentMethod @default(CASH)
  paymentDate     DateTime?
  dueDate         DateTime?
  status          PaymentStatus @default(UNPAID)
  qrPayload       String?
  // Phiếu thu theo tháng: "YYYY-MM" và ảnh chụp số liệu đối chiếu (JSON) in trên phiếu
  billingMonth    String?
  billingSummary  String?
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  note            String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  createdById String
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  lineItems     PaymentLineItem[]
  makeUpCredits MakeUpLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, billingMonth])
}

model PaymentLineItem {
  id          String          @id @default(uuid())
  description String
  category    PaymentCategory @default(TUITION)
  quantity    Int             @default(1)
  unitAmount  Float
  totalAmount Float

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId])
}

model PlacementTest {
  id             String   @id @default(uuid())
  testDate       DateTime
  listeningScore Float?
  readingScore   Float?
  writingScore   Float?
  speakingScore  Float?
  totalScore     Float?
  levelResult    String?
  teacherComment String?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  suggestedCourseId String?
  suggestedCourse   Course? @relation(fields: [suggestedCourseId], references: [id])

  suggestedClassId String?
  suggestedClass   Class?  @relation(fields: [suggestedClassId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlacementQuestion {
  id           String       @id @default(uuid())
  type         String
  question     String
  options      String // JSON array of answer choices
  correctIndex Int
  order        Int          @default(0)
  level        CourseLevel?
  isPublished  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// SCORES & CLASS NOTES
// ------------------------------------------------------

model Score {
  id       String    @id @default(uuid())
  type     ScoreType
  value    Float
  maxValue Float     @default(10)
  note     String?
  date     DateTime  @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ScoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, date])
  @@index([studentId, classId])
}

model ClassNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ClassNoteAuthor", fields: [authorId], references: [id])

  @@index([classId, createdAt])
}

// ------------------------------------------------------
// CMS & LOGS
// ------------------------------------------------------

model Page {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  content        String
  seoTitle       String?
  seoDescription String?
  status         EntityStatus @default(ACTIVE)
  // Trang tự tạo hiện thêm vào menu website (sau các mục cố định)
  showInMenu     Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id       String       @id @default(uuid())
  question String
  answer   String
  category String?
  position Int          @default(0)
  status   EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  excerpt        String?
  content        String
  thumbnail      String?
  status         EntityStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String  @id @default(uuid())
  title      String?
  subtitle   String?
  image      String
  buttonText String?
  buttonUrl  String?
  position   Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFile {
  id       String  @id @default(uuid())
  url      String // Cloudinary secure_url
  publicId String  @unique // Cloudinary public_id (for deletion)
  name     String // Original file name
  alt      String? // Alt text
  folder   String  @default("general") // Cloudinary folder / category
  format   String? // jpg, png, webp...
  width    Int?
  height   Int?
  bytes    Int? // file size in bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String  @id @default(uuid())
  authorName  String
  authorTitle String?
  content     String
  avatar      String?
  rating      Int     @default(5)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id      String  @id @default(uuid())
  title   String
  message String
  isRead  Boolean @default(false)
  link    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String  @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  details    String? // Can be JSON string

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

