# Chạy local (npm run dev). Trên Cloudflare, secret đặt bằng `npx cf secret put <TÊN>`.
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# Chỉ cho script Node (seed, admin:set-password) kết nối D1 qua HTTP API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Chỉ cho script chuyển dữ liệu một lần từ Supabase
SUPABASE_DATABASE_URL=
